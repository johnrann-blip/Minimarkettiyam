# Online payment gateway (disabled until public HTTPS hosting is ready)
ZARINPAL_ENABLED=false
ZARINPAL_MODE=sandbox
ZARINPAL_MERCHANT_ID=
PUBLIC_BASE_URL=

# Production image storage:
# Use Cloudinary for ephemeral hosts (for example Render).
# On a host with persistent disk storage (for example cPanel), set # UPLOAD_STORAGE=local  # Explicitly enable only on hosts with persistent disk storage, such as cPanel..
UPLOAD_STORAGE=local
