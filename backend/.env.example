PORT=3000
DATABASE_URL=postgres://YOUR_TEST_DB_USER:YOUR_TEST_DB_PASSWORD@127.0.0.1:5432/avelora_staging
ADMIN_API_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_BYTES
# Staging only: keep NODE_ENV=development unless the hosting environment requires production.
# If NODE_ENV=production is required by the host, use a dedicated staging DB and unique secrets.
# NODE_ENV=production
STORE_NAME=AVELORA
BANK_CARD_NUMBER=
BANK_ACCOUNT_NAME=
# Staging safety: keep all online payment providers disabled.
ZARINPAL_ENABLED=false
ZARINPAL_MODE=sandbox
ZARINPAL_MERCHANT_ID=
PUBLIC_BASE_URL=

# Production image storage:
# Use Cloudinary for ephemeral hosts (for example Render).
# cPanel with persistent disk storage: UPLOAD_STORAGE=local
# Ephemeral hosting: configure Cloudinary and remove/omit UPLOAD_STORAGE=local.
UPLOAD_STORAGE=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
